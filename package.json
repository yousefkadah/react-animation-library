{
  "name": "@yousefkadah/react-magic-ui",
  "version": "1.0.0",
  "description": "70+ free and open-source animated components for React, built with Tailwind CSS and Motion. Copy-paste them with the shadcn CLI or install from npm.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yousefkadah/react-animation-library.git"
  },
  "homepage": "https://yousefkadah.github.io/react-animation-library/",
  "bugs": {
    "url": "https://github.com/yousefkadah/react-animation-library/issues"
  },
  "scripts": {
    "dev": "npm run registry:meta && vite",
    "build": "npm run registry && npm run build:site && npm run build:lib",
    "build:site": "vite build",
    "build:lib": "vite build --mode lib",
    "registry": "node scripts/build-registry.mjs --strict && shadcn build --output public/r",
    "registry:meta": "node scripts/build-registry.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "npm run registry && npm run build:site && gh-pages -d dist-site --dotfiles",
    "prepublishOnly": "node scripts/build-registry.mjs --strict && npm run typecheck && npm test && npm run build:lib"
  },
  "keywords": [
    "react",
    "nextjs",
    "animation",
    "animated-components",
    "motion",
    "framer-motion",
    "tailwindcss",
    "shadcn",
    "magic-ui",
    "ui-library",
    "components",
    "design-engineering"
  ],
  "author": "Yousef Kadah",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "rough-notation": "^0.5.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "shadcn": "^4.0.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
