{
  "name": "ripple-button",
  "title": "Ripple Button",
  "description": "An animated button with ripple useful for user engagement.",
  "category": "buttons",
  "exports": [
    "RippleButton"
  ],
  "dependencies": [],
  "cssVars": {
    "theme": {
      "animate-rippling": "rippling var(--duration) ease-out"
    }
  },
  "css": {
    "@keyframes rippling": {
      "0%": {
        "opacity": "1"
      },
      "100%": {
        "transform": "scale(2)",
        "opacity": "0"
      }
    }
  },
  "usage": "import { RippleButton } from \"@/components/ui/ripple-button\"\n\nexport function Cta() {\n  return (\n    <RippleButton rippleColor=\"#ADD8E6\" onClick={() => console.log(\"clicked\")}>\n      Click me\n    </RippleButton>\n  )\n}",
  "examples": [
    {
      "name": "ripple-button-demo",
      "title": "Default"
    },
    {
      "name": "ripple-button-custom",
      "title": "Custom colour and speed"
    }
  ],
  "api": [
    {
      "name": "RippleButton",
      "props": [
        {
          "name": "className",
          "type": "string",
          "description": "Classes for the button."
        },
        {
          "name": "rippleColor",
          "type": "string",
          "default": "\"#ffffff\"",
          "description": "Colour of the ripple."
        },
        {
          "name": "duration",
          "type": "string",
          "default": "\"600ms\"",
          "description": "Duration of one ripple, e.g. `600ms` or `1s`."
        },
        {
          "name": "children",
          "type": "React.ReactNode",
          "description": "Button label."
        },
        {
          "name": "onClick",
          "type": "(event: React.MouseEvent<HTMLButtonElement>) => void",
          "description": "Called on click, after the ripple is spawned."
        }
      ]
    }
  ]
}
