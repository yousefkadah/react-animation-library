{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "ripple-avatar",
  "title": "Ripple — Incoming call",
  "registryDependencies": [
    "https://yousefkadah.github.io/react-animation-library/r/ripple.json"
